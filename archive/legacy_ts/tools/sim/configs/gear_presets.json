// D-083 gear presets for the simulator. Every item is a real ItemDefs base; its random properties
// (affixes, sets) come from ItemGen with the config's gear_seed, so a preset gives the same items every run.
//   "starter": true   -> first the D-082b white kit (ItemDefs.starter_kit: plain clothes + class weapon)
//   "slots"           -> these slots get the class's base (sim_party.gd AUTO_BASES) at "rarity" and "ilvl"
//   "bases"           -> change the base of a slot, e.g. {"main_hand": "greataxe"}
//   "items"           -> extra items: {"base": "sword", "rarity": "rare", "ilvl": 5, "slot": "main_hand",
//                        "stats": {"atk": 9} fixed values, "affixes": [] no random affixes}
// Rarities: common, uncommon, rare, epic, legendary, unique. Slots that the game has not opened yet are skipped.
// tierN_def = armour pieces, tierN_atk = weapon and jewels (D-084 archetypes).
// tier1/tier2/tier3 are a first guess for floors 1-3 / 4-6 / 7-10 (assumption, to be tuned).
{
    "kit_blanco": {"_comment": "what every hero starts with (D-082b)", "starter": true},
    "sin_nada": {"_comment": "naked, no weapon", "starter": false},
    "tier1": {"starter": true, "rarity": "uncommon", "ilvl": 3,
        "slots": ["main_hand", "off_hand", "head", "chest", "hands", "legs", "feet"]},
    "tier2": {"starter": true, "rarity": "rare", "ilvl": 6,
        "slots": ["main_hand", "off_hand", "head", "chest", "hands", "legs", "feet", "amulet", "ring1"]},
    "tier3": {"starter": true, "rarity": "epic", "ilvl": 10,
        "slots": ["main_hand", "off_hand", "head", "chest", "hands", "legs", "feet", "amulet", "ring1", "ring2", "special"]},
    "tier1_def": {"starter": true, "rarity": "uncommon", "ilvl": 3, "slots": ["off_hand", "head", "chest", "legs", "feet"],
        "bases": {"head": "helm", "chest": "mail"}},
    "tier1_atk": {"starter": true, "rarity": "uncommon", "ilvl": 3, "slots": ["main_hand", "hands", "ring1", "amulet"]},
    "tier2_def": {"starter": true, "rarity": "rare", "ilvl": 6, "slots": ["off_hand", "head", "chest", "hands", "legs", "feet", "amulet"],
        "bases": {"head": "helm", "chest": "mail"}},
    "tier2_atk": {"starter": true, "rarity": "rare", "ilvl": 6, "slots": ["main_hand", "hands", "ring1", "ring2", "amulet", "special"]},
    "tier3_def": {"starter": true, "rarity": "epic", "ilvl": 10, "slots": ["off_hand", "head", "chest", "hands", "legs", "feet", "amulet", "special"],
        "bases": {"head": "helm", "chest": "mail"}},
    "tier3_atk": {"starter": true, "rarity": "epic", "ilvl": 10, "slots": ["main_hand", "hands", "ring1", "ring2", "amulet", "special", "head"]}
}

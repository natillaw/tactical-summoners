// D-083 example: floor 1 (1 hero: the Master alone) played by the tactical bot and by the "loco" bot.
// Run:  godot --headless --path . -s res://tools/sim/run_sim.gd -- --config tools/sim/configs/floor1_tactico_vs_loco.json
{
    "name": "floor1_tactico_vs_loco",
    "floors": [1],               // a list, a number or a range "1-10"
    "runs": 30,                  // seeds seed .. seed+runs-1 (or "seeds": [..])
    "seed": 1000,
    "max_time": 1200,            // seconds of game per run before it counts as TIMEOUT
    "tick_hz": 30,               // fixed step (the bots of D-082 use 30; the game ticks at 60)
    "party": [                   // the floor deploys as many as it allows (floor 1 = 1: the Master)
        {"master": true, "class": "warrior", "level": 1, "gear": "kit_blanco"},
        {"class": "cleric", "level": 1, "stars": 2, "gear": "kit_blanco"},
        {"class": "archer", "level": 1, "stars": 2, "gear": "kit_blanco"},
        {"class": "mage", "level": 1, "stars": 2, "gear": "kit_blanco"},
        {"class": "rogue", "level": 1, "stars": 2, "gear": "kit_blanco"}
    ],
    "compare": [
        {"label": "tactico", "bot": {"style": "tactico"}},
        {"label": "loco", "bot": {"style": "loco"}}
    ]
}

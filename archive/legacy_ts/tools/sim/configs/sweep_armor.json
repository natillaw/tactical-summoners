// D-083 example: sweep of the flat armour per blow (D-082) on floor 2, tactical bot.
// "param" can be a constant ("Class.CONSTANT", or a key inside a table: "TowerExpedition.FLOORS.2.threat")
// or a config value ("bot.retreat_hp", "enemies.hp"). Constants are replaced at run time in a copy of
// the script; the repository is never written.
{
    "name": "sweep_armor",
    "floors": [2],
    "runs": 20,
    "seed": 3000,
    "bot": {"style": "tactico"},
    "sweep": {"param": "CombatRules.ARMOR_FLAT", "from": 0.1, "to": 0.4, "step": 0.05}
}

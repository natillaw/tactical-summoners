{
  "rule": "blob47",
  "neighbourBits": {
    "n": 1,
    "ne": 2,
    "e": 4,
    "se": 8,
    "s": 16,
    "sw": 32,
    "w": 64,
    "nw": 128
  },
  "howTo": "For a cell, add the bit of every neighbour (of the same kind) that is present. A diagonal bit only counts when both orthogonal neighbours beside it are present: drop it otherwise. The result is one of 47 masks; look it up in `sets`. Animated entries (water, lava) are base names: append _f0.._f3 for the frames.",
  "floor": {
    "stamp": 4,
    "howTo": "Place floor_<stone|moss>_r<y mod 4>c<x mod 4> at cell (x, y). Moss tiles may replace stone tiles of the same r/c anywhere."
  },
  "wallFace": {
    "rows": [
      "upper",
      "lower"
    ],
    "howTo": "A floor cell directly south of a wall-top cell shows wall_face_upper_*; the cell below that shows wall_face_lower_*. Use end_w / end_e / end_we where the wall does not continue to the west / east."
  },
  "shadow": "Draw shadow_wall over the floor cell directly beneath the lower face row.",
  "liquidLayers": "Draw water, lava and pit tiles on a layer above the floor. Pixels outside their shoreline are transparent, so the floor underneath supplies the bank.",
  "waterOverlay": "On every water cell whose eight neighbours are all water (mask 255), also draw water_caustic_r<y mod 4>c<x mod 4> (4 frames, transparent) on top of the water tile. It adds long ripple contours that do not repeat tile by tile.",
  "overlays": "trap_spikes (6 frames) and trap_plate (2 frames) are transparent: draw them on top of a floor tile. stairs_down_<dir> replaces a floor tile; <dir> is the way the stairs descend.",

extends Control
## Expeditions (D-051..D-056): fog of war (sight belongs to heroes, not the camera; persistence),
## direct control and obedience, map generator v2 (size, zones, encounters, snapshot persistence),
## creature roles, real difficulty (a lone level-1 hero gets hurt) and heroes visible in the town.
##   godot --headless --path . res://tests/smoke_expedition.tscn --quit-after 3000
var fails := 0


func check(cond: bool, msg: String) -> void:
    print("  ", "PASS  " if cond else "FAIL  ", msg)
    if not cond:
        fails += 1


func _ready() -> void:
    print("== Expedition tests ==")
    Game.autosave = false
    Game.save_path = "user://smoke_expedition.json"
    Game.new_game()

    # --- map generator v2 --------------------------------------------------------------------
    var cfg := TowerExpedition.get_floor_config(1)
    var m := ProceduralMap.new(int(cfg["width"]), int(cfg["height"]), 4242, 1)
    check(m.gen_version == 2 and m.width >= 90 and m.height >= 78, "floor 1 is generated by v2 at %dx%d cells" % [m.width, m.height])
    var members := 0
    var near_spawn := false
    var start := m.center_of(m.spawn_cells[0])
    for e in m.encounters:
        members += (e["members"] as Array).size()
        for c in e["cells"]:
            if m.center_of(c).distance_to(start) < 10.0 * NavMap.CELL:
                near_spawn = true
    check(m.encounters.size() >= 5 and members >= 12, "floor 1 has %d encounters / %d creatures, not 4 lone foes" % [m.encounters.size(), members])
    check(not near_spawn, "the entrance is quiet: no encounter within 10 cells of the spawn")
    var kinds := {}
    for e in m.encounters:
        kinds[e["kind"]] = true
    check(kinds.size() >= 2, "encounters of several kinds: %s" % str(kinds.keys()))
    check(m.encounters.any(func(e): return e["zone"] == "objective"), "the goal is guarded")
    var snap := m.to_snapshot()
    var back := ProceduralMap.from_snapshot(JSON.parse_string(JSON.stringify(snap)), 1)
    check(back.grid_rows == m.grid_rows and back.encounters.size() == m.encounters.size() and back.goal_cell == m.goal_cell,
        "a floor survives a JSON snapshot round trip unchanged (D-004 / D-026)")
    var f1 := Game.get_or_create_tower_floor_map(1)
    var f1b := Game.get_or_create_tower_floor_map(1)
    check(f1.grid_rows == f1b.grid_rows and int(Game.tower_maps["1"]["gen"]) == 2, "the account's floor 1 loads identical the second time")
    Game.tower_maps["7"] = {"seed": 99, "width": 56, "height": 52}            # a floor saved before v2
    var legacy := Game.get_or_create_tower_floor_map(7)
    check(legacy.gen_version == 1 and legacy.width == 56, "a floor saved before v2 keeps being built by generator 1")
    var mig := Game._migrate({"version": 9, "tower_maps": {"3": {"seed": 5, "width": 48, "height": 44}}})
    check(int(mig["tower_maps"]["3"]["gen"]) == 1 and mig["tower_maps"]["3"].has("explored") and int(mig["version"]) == Game.SAVE_VERSION,
        "save v9 -> v10: old floors are marked generator 1, nothing rerolled")
    Game.tower_maps.erase("7")

    # --- a real expedition screen on floor 1 -------------------------------------------------
    var sb := SandboxScreen.new(1)
    add_child(sb)
    sb.size = Vector2(1280, 720)
    await get_tree().process_frame
    check(sb.enemies.size() >= 12, "floor 1 spawns its encounters (%d creatures)" % sb.enemies.size())
    var far: Array = sb.enemies.filter(func(e): return e.position.distance_to(sb.heroes[0].position) > 900.0)
    check(not far.is_empty() and far.all(func(e): return not e.visible), "creatures far from the squad are hidden by the fog")
    var explored_before := sb.fog.explored_fraction()
    sb.overview = true
    for i in 30:
        sb.tick(1.0 / 30.0)
    check(is_equal_approx(sb.fog.explored_fraction(), explored_before) and far.all(func(e): return not e.visible),
        "zooming out to the whole-map view reveals nothing (sight is the heroes', not the camera's)")
    sb.overview = false
    var never := 0
    for s in sb.fog.state:
        if s == FogMap.NEVER:
            never += 1
    check(never > sb.fog.state.size() / 2, "most of the floor starts unexplored")
    var scout: SandboxHero = null
    var plain: SandboxHero = null
    for h in sb.heroes:
        if CombatRules.SCOUT_CLASSES.has(h.hero.hero_class):
            scout = h
        elif plain == null:
            plain = h
    if scout != null and plain != null:
        check(scout.vision_cells() > plain.vision_cells(), "scouts see further than other heroes")
    var packed := sb.fog.pack()
    var fog2 := FogMap.new(sb.fog.width, sb.fog.height)
    fog2.unpack(packed)
    check(is_equal_approx(fog2.explored_fraction(), sb.fog.explored_fraction()), "explored cells pack/unpack exactly (%d chars)" % packed.length())

    # --- direct control and obedience ----------------------------------------------------------
    sb.select_slot(1)
    check(sb.heroes[1].is_controlled() and sb.controlled() == sb.heroes[1], "1-5 takes direct control of that hero (D-053)")
    check(sb.heroes.filter(func(h): return h.is_controlled()).size() == 1, "only one hero is driven; the others stay autonomous")
    var cd_before: float = sb.heroes[1].skill_cd(0)
    sb.select_slot(2)
    check(sb.heroes[2].is_controlled() and not sb.heroes[1].is_controlled() and is_equal_approx(sb.heroes[1].skill_cd(0), cd_before),
        "switching heroes moves control without resetting cooldowns")
    sb.heroes[3].hero.obedience = 10
    sb.select_slot(3)
    check(not sb.heroes[3].is_controlled() and sb.heroes[2].is_controlled(), "a hero without obedience cannot be taken under control (D-051)")
    sb.select_all()
    check(not sb.selected.has(sb.heroes[3]), "... nor receives squad orders")
    sb.heroes[3].hero.obedience = 50
    sb.group_view()
    check(sb.controlled() == null, "group view returns every hero to autonomy")

    # aimed area skill lands at the cursor, clamped to its reach
    var h: SandboxHero = sb.heroes[0]
    h.slots.clear()
    h.slots.append("fire_burst")
    h.res = h.res_max
    h.cds.clear()
    h.controller = "player"
    var aim := h.position + Vector2(1000, 0)
    check(h.use_skill_slot(0, sb.living_enemies(), sb.heroes, aim), "a driven hero can aim an area skill at the ground")
    check(h.cast_point.distance_to(h.position) <= float(SkillDefs.info("fire_burst")["range"]) + 1.0, "the aimed area is clamped to the skill's reach")
    h.controller = "ai"
    h.interrupt_cast()

    # --- D-059: the driven hero attacks only with Q, aimed at the mouse ---------------------------
    var archer_h: SandboxHero = null
    var melee_h: SandboxHero = null
    for hh in sb.heroes:
        if hh.is_ranged() and archer_h == null:
            archer_h = hh
        elif not hh.is_ranged() and melee_h == null:
            melee_h = hh
    if archer_h == null:
        archer_h = sb.heroes[4]
        archer_h.hero.hero_class = "class.ranger"
    var dummy := sb._spawn_enemy(sb.map.cell_of(archer_h.position), "slime_green")
    dummy.position = archer_h.position + Vector2(120, 0)
    dummy.perception = 0.0
    dummy.visible = true
    sb.select_slot(sb.heroes.find(archer_h))
    var hp_d := dummy.hp
    for i in 40:
        archer_h.tick(0.05)
        archer_h.combat_tick([dummy], sb.map)
    check(dummy.hp == hp_d, "a driven archer never shoots on its own")
    check(not archer_h.aimed_attack(archer_h.position + Vector2(0, 200), [dummy], sb.map) or dummy.hp == hp_d, "aiming away from the foe")
    for i in 20:
        archer_h.tick(0.05)
    check(dummy.hp == hp_d, "... misses it: the shot flies where the mouse points")
    archer_h._cooldown = 0.0
    check(archer_h.aimed_attack(dummy.position, [dummy], sb.map), "Q fires toward the cursor when the attack is ready")
    check(not archer_h.aimed_attack(dummy.position, [dummy], sb.map), "the attack interval still applies")
    for i in 20:
        archer_h.tick(0.05)
    check(dummy.hp < hp_d, "the arrow hits the foe on its line, on arrival (%d -> %d)" % [hp_d, dummy.hp])
    if melee_h != null:
        sb.select_slot(sb.heroes.find(melee_h))
        dummy.hp = dummy.max_hp
        dummy.position = melee_h.position + Vector2(40, 0)
        melee_h._cooldown = 0.0
        melee_h.aimed_attack(melee_h.position + Vector2(-100, 0), [dummy], sb.map)
        check(dummy.hp == dummy.max_hp, "a melee swing away from the foe misses")
        melee_h._cooldown = 0.0
        melee_h.aimed_attack(dummy.position, [dummy], sb.map)
        check(dummy.hp < dummy.max_hp, "a melee swing toward it hits")
    sb.group_view()
    dummy.queue_free()
    sb.enemies.erase(dummy)

    # --- creature roles ----------------------------------------------------------------------
    var healer := SandboxEnemy.new()
    healer.setup_type("mushroom_red", 1)
    var hurt := SandboxEnemy.new()
    hurt.setup_type("slime_green", 1)
    sb._world.add_child(healer)
    sb._world.add_child(hurt)
    healer.position = Vector2(-5000, -5000)
    hurt.position = healer.position + Vector2(60, 0)
    hurt.hp = hurt.max_hp / 3
    var before := hurt.hp
    healer._allies = [healer, hurt]
    healer.tick(0.1, [], sb.map)
    check(healer.role == "support" and hurt.hp > before, "a support creature heals a hurt ally (%d -> %d)" % [before, hurt.hp])
    var archer := SandboxEnemy.new()
    archer.setup_type("spider", 1)
    check(archer.role == "ranged" and archer.strike_range >= 140.0, "a ranged creature strikes from afar (%.0f px)" % archer.strike_range)
    var rat := SandboxEnemy.new()
    rat.setup_type("rat", 1)
    var golem := SandboxEnemy.new()
    golem.setup_type("golem", 1)
    check(rat.max_hp < 40 and golem.max_hp > 250 and golem.mass > rat.mass, "creatures differ: rat %d HP, golem %d HP" % [rat.max_hp, golem.max_hp])
    var a := SandboxEnemy.new()
    var b := SandboxEnemy.new()
    a.group_mates = [a, b]
    b.group_mates = [a, b]
    b.dormant = true
    a.take_hit(DamageInfo.make(1.0, "true", null))
    check(a.alerted and b.alerted and not b.dormant, "hurting one creature alerts its whole encounter")
    for n in [healer, hurt, archer, rat, golem, a, b]:
        n.queue_free()

    # --- difficulty: one level-1 hero against one floor-1 group --------------------------------
    var lone: SandboxHero = sb.heroes[0]
    for other in sb.heroes:
        if other != lone:
            other.position = Vector2(-9000, -9000)
            other.stop()
    for e in sb.enemies:
        e.position = Vector2(9000, 9000)
        e.perception = 0.0
    var group: Array = []
    for t in ["slime_green", "rat", "rat"]:
        var e := sb._spawn_enemy(sb.map.cell_of(lone.position), t)
        e.position = lone.position + Vector2(90 + group.size() * 22, 10 * group.size())
        group.append(e)
    for e in group:
        e.group_mates = group
    lone.hero.level = 1
    lone.hp = lone.max_hp
    var hp0 := lone.hp
    for i in 600:
        sb.tick(0.05)
        if not lone.alive or group.all(func(e): return not e.alive):
            break
    print("  METRIC lone level-1 hero vs slime + 2 rats: hero %d/%d HP left (%s), foes left %d" % [lone.hp, lone.max_hp,
        "down" if not lone.alive else "standing", group.filter(func(e): return e.alive).size()])
    check(lone.hp < hp0 or not lone.alive, "a lone level-1 hero takes real damage from a single floor-1 group")
    sb.queue_free()

    # --- town: heroes are physically there -----------------------------------------------------
    Game.gems = 100000
    Game.pull(6)
    var town := TownScreen.new()
    add_child(town)
    town.size = Vector2(1280, 720)
    await get_tree().create_timer(1.0).timeout
    check(town.heroes.size() == Game.heroes.size() and town.heroes.size() >= 6, "every living hero has a body in the town (%d)" % town.heroes.size())
    var gone: HeroData = Game.heroes.values()[0]
    Game.record_death(gone, "test", "test")
    town.rebuild()
    await get_tree().process_frame
    check(not town.heroes.any(func(th): return th.hero == gone), "a hero who died for good no longer walks the town")
    town.queue_free()

    print("== ALL PASSED ==" if fails == 0 else "== %d FAILED ==" % fails)
    get_tree().quit(0 if fails == 0 else 1)
